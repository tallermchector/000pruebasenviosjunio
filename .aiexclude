# .aiexclude - Google Jules & Gemini Context Optimization Rules
# Optimize the context window by ignoring redundant, build, and heavy data files.

# 1. Build Artifacts & Runtime Cache
node_modules/
.next/
dist/
build/
out/
.vercel/
.turbo/
*.log
*.lockb
pnpm-lock.yaml
yarn.lock
package-lock.json

# 2. Configuration & Meta-data (Redundant for logic reasoning)
.vscode/
.idx/
.git/
.modified
.husky/
.github/
apphosting.yaml
components.json
postcss.config.mjs
tailwind.config.ts
tailwind.config.js
tsconfig.json
eslint.config.mjs
next.config.mjs
next.config.js
next-env.d.ts
prettier.config.js

# 3. Generated Data & Heavy Schemas
prisma/migrations/
prisma/datos/*.json
prisma/*.db
prisma/*.db-journal
generated/
.agent/skills/ui-ux-pro-max/data/
.agent/skills/ui-ux-pro-max/scripts/
scripts/respuestas/
coverage/

# 4. Binaries, Media & Static Assets
public/fonts/
public/images/
*.png
*.jpg
*.jpeg
*.svg
*.webp
*.ico
*.gif
*.mp4
*.webm
*.pdf

# 5. Support Documentation (Except core AI instructions)
docs/
